{
  "name": "design-system",
  "sourceRoot": "apps/design-system/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/design-system",
        "command": "tsc -p tsconfig.json && storybook build --output-dir ../../dist/design-system --disable-telemetry"
      },
      "outputs": ["{workspaceRoot}/dist/design-system"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/design-system",
        "command": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/design-system",
        "command": "vite preview --outDir ../../dist/design-system --host 127.0.0.1 --port 6006 --strictPort"
      }
    }
  }
}
