{
  "name": "web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b && cd apps/web && vite build"
      },
      "outputs": [
        "{workspaceRoot}/dist/web"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/web"
      }
    }
  },
  "implicitDependencies": [
    "brand"
  ]
}
