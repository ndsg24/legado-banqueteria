meta {
  name: List quotes
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/admin/quotes?pageSize=10&page=1&sort=date&direction=asc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  ~status: active
  pageSize: 10
  page: 1
  sort: date
  direction: asc
  ~from: 2026-11-01
  ~to: 2026-11-30
  ~search: Concepción
  ~event: wedding
  ~before: {{quoteNumber}}
}

script:post-response {
  const first = res.getBody().items[0];
  if (first) bru.setVar("quoteNumber", first.number);
}

assert {
  res.status: eq 200
}
