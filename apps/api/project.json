{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.json && node apps/api/build.mjs"
      },
      "outputs": [
        "{workspaceRoot}/dist/api"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file-if-exists=.env dist/api/main.cjs"
      },
      "dependsOn": [
        "build"
      ]
    }
  }
}
