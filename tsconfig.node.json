{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["apps/web/vite.config.ts", "playwright.config.ts", "tests/**/*.ts", "apps/web/src/app/routing/metadata.ts", "libs/domain/i18n/messages.ts", "libs/domain/i18n/locales/es/**/*", "apps/web/src/shared/config/heroPhoto.ts"],
  "exclude": ["tests/worker.spec.ts"]
}
