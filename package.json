{
  "name": "legado-banqueteria",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "check": "npm run check:i18n && npm run format:check && npm run lint && npm run build",
    "audit:security": "npm audit --include=dev --audit-level=moderate",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\" \"public/*.{js,css}\" vite.config.ts eslint.config.js tools/eslint/*.js \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\" \"public/*.{js,css}\" vite.config.ts eslint.config.js tools/eslint/*.js \"tests/**/*.ts\" playwright.config.ts",
    "test:e2e": "playwright test",
    "check:i18n": "node tools/check-locales.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@internationalized/date": "^3.12.4",
    "flag-icons": "^7.6.0",
    "framer-motion": "12.42.2",
    "gsap": "^3.15.1",
    "pdfmake": "^0.3.14",
    "react": "^19.0.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.18.6",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
